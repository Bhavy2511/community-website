MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/gujarati-community-iitg?retryWrites=true&w=majority
MONGODB_DB_NAME=gujarati-community-iitg
MONGODB_MAX_POOL_SIZE=10
AGENTMAIL_API_KEY_COMMUNITY=am_xxxxxxxxx
AGENTMAIL_API_KEY_GARBARAAS=am_xxxxxxxxx
AGENTMAIL_INBOX=gujaraticommunityiitg@agentmail.to
CONTACT_TO_EMAIL=gujaraticommunityiitg@gmail.com
KURTA_ORDER_CONTACT_EMAIL=garbaraasiitg@gmail.com
KURTA_ORDER_AGENTMAIL_INBOX=garbaraas.iitg@agentmail.to
KOTI_ORDER_AGENTMAIL_INBOX=garbaraas.iitg@agentmail.to

# Chanda collection. Use a public path/URL for the payment QR, never a payment secret.
# Recommended: an independent random secret of at least 32 characters.
CHANDA_SESSION_SECRET=replace_with_a_second_long_random_secret
CHANDA_PAYMENT_QR_URL=
# Temporary testing only. Keep false/blank once the official QR is installed.
CHANDA_ALLOW_DEMO_ONLINE=false
CHANDA_AGENTMAIL_INBOX=garbaraas.iitg@agentmail.to
CHANDA_POC_REQUEST_TO_EMAIL=r.pansuriya@iitg.ac.in

# Separate Chanda-admin lock. The email is fixed; generate the password hash with:
# node scripts/hash-chanda-admin-password.mjs
CHANDA_ADMIN_EMAIL=garbaraas.iitg@gmail.com
CHANDA_ADMIN_PASSWORD_HASH=scrypt$replace_with_generated_hash
CHANDA_ADMIN_SESSION_SECRET=replace_with_a_third_long_random_secret

# Production remains closed unless this is explicitly set to true at build/deploy time.
MERCH_ORDERS_ENABLED=false
KURTA_PAYMENT_UPI_ID=your-upi-id@bank
KOTI_PAYMENT_UPI_ID=your-upi-id@bank

# Admin publishing. Keep real values only in .env.local, never in git.
# Generate the hash with: node scripts/hash-admin-password.mjs
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt$replace_with_generated_hash
SESSION_SECRET=replace_with_a_long_random_secret

# News-email testing. Sends only to this address while test mode is enabled.
NEWS_TEST_RECIPIENT=r.pansuriya@iitg.ac.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
